# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///gated_manila.db

# Cloudflare Turnstile (free). The test keys below always pass; replace in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Spam and brute-force limits (per visitor IP)
SUBMIT_RATE_LIMIT=5 per hour
LOGIN_RATE_LIMIT=10 per 15 minutes

# Set to 1 in production (HTTPS only)
SESSION_COOKIE_SECURE=0
